# Copy this file to `.env` (same folder as docker-compose.yml). It is gitignored.
# Docker Compose auto-loads `.env` and injects these into the api container.

# --- JWT ---
# JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# --- Email (Brevo SMTP relay) ---
# In Brevo: Settings -> SMTP & API -> SMTP tab.
#   MAIL_USERNAME = the SMTP login shown there (looks like 8xxxxx@smtp-brevo.com)
#   MAIL_PASSWORD = an SMTP key you generate on that page (NOT your Brevo login password)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-login@smtp-brevo.com
MAIL_PASSWORD=your-brevo-smtp-key

# From address shown to recipients.
# Brevo requires this to be a verified sender, and for a custom domain you must
# authenticate the domain (SPF/DKIM) under Senders, Domains & Dedicated IPs.
MAIL_FROM=noreply@academyoftesters.com
MAIL_FROM_NAME=Academy of Testers

# --- OpenAI (AI Study Helper) ---
# OPENAI_API_KEY=sk-your-key-here
