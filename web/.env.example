# API Configuration (optional in local dev)
# Leave unset to use same-origin /api (Vite proxies to the Spring server).
# Set to your deployed API for production builds, e.g. https://api.example.com/api
# VITE_API_URL=https://your-api.example.com/api
#
# When using the default proxy, override the backend host/port if needed:
# VITE_API_PROXY_TARGET=http://localhost:8080

# OpenAI API key for the AI Study Helper chat feature
# Not prefixed with VITE_ so it stays server-side only (never sent to the browser)
OPENAI_API_KEY=sk-your-key-here
